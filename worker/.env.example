# ==============================================================================
# Переменные окружения фонового воркера (Looksmaxxing AI Rating Platform Worker)
# Скопируйте этот файл в worker/.env или используйте корневой .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq API (Обязательно)
# ------------------------------------------------------------------------------
# API-ключ от Groq Cloud Console (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Мультимодальная модель для визуального анализа лица
# Актуальные модели Groq с поддержкой изображений:
# - qwen/qwen3.6-27b (по умолчанию; поддерживает JSON-режим вместе с картинкой)
# - qwen/qwen3.8-27b (настраиваемая глубина рассуждений)
# Модели llama-3.2-*-vision-preview выведены из эксплуатации и больше не отвечают
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Опционально: переопределение общего AI провайдера (groq, openai, anthropic)
# AI_PROVIDER=groq
# AI_MODEL=qwen/qwen3.6-27b

# ------------------------------------------------------------------------------
# 2. Подключение к PostgreSQL и очереди pgmq (Обязательно)
# ------------------------------------------------------------------------------
# URL прямого подключения к базе данных Supabase Postgres
# Локально: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Продакшен: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Имя очереди pgmq
PGMQ_QUEUE_NAME=rating_tasks

# Время скрытия сообщения при чтении из очереди (Visibility Timeout) в секундах
PGMQ_VT_SECONDS=60

# ------------------------------------------------------------------------------
# 3. Supabase Storage (Обязательно для скачивания приватных фото)
# ------------------------------------------------------------------------------
# Базовый URL инстанса Supabase
# Локально: http://127.0.0.1:54321
# Продакшен: https://[PROJECT-REF].supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Сервисный ключ с правами service_role (обход RLS для приватного бакета Storage)
# ВНИМАНИЕ: Никогда не передавайте этот ключ на клиент!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Имя приватного бакета Supabase Storage с фотографиями пользователей
RATINGS_BUCKET=ratings_photos

# ------------------------------------------------------------------------------
# 4. Настройки Long-Polling и устойчивости воркера
# ------------------------------------------------------------------------------
# Интервал опроса очереди при отсутствии сообщений (в миллисекундах)
WORKER_POLL_INTERVAL_MS=1500

# Пауза при сбое сети или ошибке цикла опроса БД (в миллисекундах)
WORKER_ERROR_COOLDOWN_MS=5000

# Максимальное количество попыток обработки задачи (read_ct) перед архивацией
MAX_TASK_RETRIES=3

# ------------------------------------------------------------------------------
# 5. Rate Limiting и троттлинг Groq API
# ------------------------------------------------------------------------------
# Минимальный интервал между запросами к Groq API (в миллисекундах)
# 3500 мс гарантирует соблюдение бесплатного лимита Groq (до ~17-20 RPM)
RATE_LIMIT_INTERVAL_MS=3500

# Базовое время экспоненциального backoff при получении HTTP 429 (в секундах)
RATE_LIMIT_BASE_BACKOFF_SEC=30

# Максимальное время скрытия задачи при повторных 429 ошибках (в секундах)
RATE_LIMIT_MAX_BACKOFF_SEC=120

# Максимальный случайный jitter для предотвращения одновременных повторов (в секундах)
RATE_LIMIT_MAX_JITTER_SEC=5
