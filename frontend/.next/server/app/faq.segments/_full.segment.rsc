11:["$","$1","c",{"children":[[["$","$L17",null,{"eyebrow":"Вопросы","title":"Частые вопросы","description":"Коротко о точности, приватности фото, режимах разбора и скорости обработки."}],["$","div",null,{"className":"mx-auto max-w-3xl px-4 py-16 sm:px-6","children":["$","$L18",null,{"type":"single","collapsible":true,"className":"w-full","children":[["$","$L19","Насколько точна эта оценка?",{"value":"Насколько точна эта оценка?","children":[["$","$L1a",null,{"className":"text-left text-base","children":"Насколько точна эта оценка?"}],["$","$L1b",null,{"className":"leading-relaxed text-muted-foreground","children":"Это оценка нейросети по одному фото, а не медицинское или экспертное заключение. Свет, ракурс, камера и выражение лица заметно влияют на результат. Относитесь к баллу как к развлечению и поводу подумать об уходе за собой, а не как к диагнозу."}]]}],["$","$L19","Что происходит с моим фото?",{"value":"Что происходит с моим фото?","children":[["$","$L1a",null,{"className":"text-left text-base","children":"Что происходит с моим фото?"}],["$","$L1b",null,{"className":"leading-relaxed text-muted-foreground","children":"Фото загружается напрямую в приватное хранилище по временной подписанной ссылке. Публичного доступа к файлу нет: посмотреть его можете только вы, авторизовавшись в своём аккаунте. Удаление оценки удаляет и запись из истории."}]]}],["$","$L19","Почему результат считается так долго?",{"value":"Почему результат считается так долго?","children":[["$","$L1a",null,{"className":"text-left text-base","children":"Почему результат считается так долго?"}],["$","$L1b",null,{"className":"leading-relaxed text-muted-foreground","children":"Задачи обрабатываются последовательно фоновым воркером с паузами между вызовами ИИ, чтобы укладываться в лимиты бесплатного API. Обычно это 15–40 секунд, но при очереди может быть дольше. Страницу можно закрыть — результат сохранится в истории."}]]}],["$","$L19","Чем отличаются режимы разбора?",{"value":"Чем отличаются режимы разбора?","children":[["$","$L1a",null,{"className":"text-left text-base","children":"Чем отличаются режимы разбора?"}],["$","$L1b",null,{"className":"leading-relaxed text-muted-foreground","children":"Меняется только тон текста, а не сам балл. Мягкий режим делает акцент на сильных сторонах и потенциале, честный даёт нейтральный реалистичный анализ, жёсткий не смягчает формулировки. Метрики и число считаются одинаково."}]]}],["$","$L19","Что такое canthal tilt?",{"value":"Что такое canthal tilt?","children":[["$","$L1a",null,{"className":"text-left text-base","children":"Что такое canthal tilt?"}],["$","$L1b",null,{"className":"leading-relaxed text-muted-foreground","children":"Это наклон линии, соединяющей внутренний и внешний уголки глаза. Позитивный наклон — внешний уголок выше внутреннего, негативный — ниже, нейтральный — на одной линии. В луксмаксинге это один из базовых параметров оценки зоны глаз."}]]}],["$","$L19","Можно ли улучшить свой тир?",{"value":"Можно ли улучшить свой тир?","children":[["$","$L1a",null,{"className":"text-left text-base","children":"Можно ли улучшить свой тир?"}],["$","$L1b",null,{"className":"leading-relaxed text-muted-foreground","children":"Часть параметров зависит от костной структуры и почти не меняется без вмешательства. Но качество кожи, процент жира, причёска, осанка, сон и уход влияют очень сильно — именно на это направлены рекомендации в разборе."}]]}],["$","$L19","Почему у меня разные баллы на разных фото?",{"value":"Почему у меня разные баллы на разных фото?","children":[["$","$L1a",null,{"className":"text-left text-base","children":"Почему у меня разные баллы на разных фото?"}],["$","$L1b",null,{"className":"leading-relaxed text-muted-foreground","children":"Так и должно быть: модель видит только то, что попало в кадр. Ровный фронтальный свет, нейтральное выражение и отсутствие сильных теней дают самый стабильный результат. Для честного сравнения снимайте в одинаковых условиях."}]]}],"$L1c"]}]}]],["$L1d"],"$L1e"]}]
