# ==============================================================================
# ЕДИНЫЙ КОНФИГУРАЦИОННЫЙ ФАЙЛ ОКРУЖЕНИЯ (Mog Production Stack)
# Скопируйте этот файл в .env на уровне docker-compose.yml:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CADDY REVERSE PROXY & DOMAIN SETTINGS
# ------------------------------------------------------------------------------
# Публичный домен проекта (Caddy автоматически выпустит и обновит SSL-сертификат).
# Для локального тестирования можно указать "localhost".
DOMAIN=mog.example.com

# ------------------------------------------------------------------------------
# 2. SUPABASE (AUTH, STORAGE, REST & EDGE FUNCTIONS)
# ------------------------------------------------------------------------------
# Базовый URL вашего Supabase проекта:
# - Продакшен (Supabase Cloud): https://<your-project-ref>.supabase.co
# - Self-hosted Supabase: https://supabase.<your-domain>.com
SUPABASE_URL=https://your-project-ref.supabase.co

# Публичный anon ключ Supabase (sb_publishable_... или JWT anon_key)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Сервисный секретный ключ Supabase с правами service_role (sb_secret_... или service_role JWT)
# ВНИМАНИЕ: Используется только на бэкенде (Worker и Edge API) для обхода RLS и приватного Storage
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Опционально: публичный URL Supabase, если запросы к Storage должны идти через кастомный прокси
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Имя приватного бакета Supabase Storage для хранения фотографий пользователей
RATINGS_BUCKET=ratings_photos

# ------------------------------------------------------------------------------
# 3. FRONTEND (NEXT.JS ПУБЛИЧНЫЕ ПЕРЕМЕННЫЕ)
# ------------------------------------------------------------------------------
# Переменные, запекаемые в бандл Next.js при сборке.
# Обычно дублируют публичные адреса Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Опционально: переопределение адреса Edge API для фронтенда.
# Если оставить пустым, по умолчанию используется "${NEXT_PUBLIC_SUPABASE_URL}/functions/v1/api".
# Если хотите отправлять запросы напрямую через Caddy домен:
# NEXT_PUBLIC_EDGE_URL=https://mog.example.com/api
NEXT_PUBLIC_EDGE_URL=

# ------------------------------------------------------------------------------
# 4. POSTGRESQL & PGMQ QUEUE (ОЧЕРЕДЬ СООБЩЕНИЙ)
# ------------------------------------------------------------------------------
# Прямая строка подключения к базе данных PostgreSQL с поддержкой расширения pgmq.
# - Продакшен (Supabase Cloud): postgresql://postgres:<DB_PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
# - Локально: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:your_secure_db_password@db.your-project-ref.supabase.co:5432/postgres

# Имя очереди pgmq для задач анализа внешности
PGMQ_QUEUE_NAME=rating_tasks

# Время скрытия сообщения при чтении из очереди (Visibility Timeout, в секундах)
PGMQ_VT_SECONDS=60

# ------------------------------------------------------------------------------
# 5. GROQ VISION AI (ИНТЕЛЛЕКТУАЛЬНЫЙ АНАЛИЗ ФОТО)
# ------------------------------------------------------------------------------
# API-ключ от консоли Groq Cloud (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Мультимодальная модель Groq с поддержкой распознавания лиц и JSON-режима
# Рекомендуемая модель: qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ------------------------------------------------------------------------------
# 6. НАСТРОЙКИ ФОНОВОГО ВОРКЕРА (LONG-POLLING & RATE LIMITING)
# ------------------------------------------------------------------------------
# Интервал опроса очереди pgmq при отсутствии новых задач (в миллисекундах)
WORKER_POLL_INTERVAL_MS=1500

# Пауза при сбое сети или временной недоступности базы данных (в миллисекундах)
WORKER_ERROR_COOLDOWN_MS=5000

# Максимальное количество попыток обработки одной задачи перед отправкой в архив
MAX_TASK_RETRIES=3

# Минимальная пауза между последовательными вызовами Groq API (в миллисекундах)
# 3500 мс гарантирует соблюдение бесплатного лимита запросов в минуту (RPM)
RATE_LIMIT_INTERVAL_MS=3500

# Экспоненциальный backoff при получении ошибки 429 (Too Many Requests) от Groq (в секундах)
RATE_LIMIT_BASE_BACKOFF_SEC=30
RATE_LIMIT_MAX_BACKOFF_SEC=120
RATE_LIMIT_MAX_JITTER_SEC=5
