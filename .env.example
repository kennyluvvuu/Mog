# ==============================================================================
# ЕДИНЫЙ КОНФИГУРАЦИОННЫЙ ФАЙЛ ОКРУЖЕНИЯ (ALL-IN-ONE MOG + SUPABASE STACK)
# Запуск "в одну кнопку":
#   cp .env.example .env
#   docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ДОМЕН И ОБРАТНЫЙ ПРОКСИ CADDY
# ------------------------------------------------------------------------------
# Публичный домен для Caddy. Caddy автоматически выпускает и обновляет SSL (Let's Encrypt).
# Для локального запуска на компьютере или VPS без домена укажите "localhost".
DOMAIN=localhost

# ------------------------------------------------------------------------------
# 2. ИИ-АНАЛИЗ ВНЕШНОСТИ (GROQ CLOUD API)
# ------------------------------------------------------------------------------
# API-ключ от консоли Groq Cloud (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Мультимодальная модель для распознавания черт лица
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ------------------------------------------------------------------------------
# 3. БАЗА ДАННЫХ POSTGRESQL & PGMQ (ВСТРОЕННЫЙ SUPABASE POSTGRES)
# ------------------------------------------------------------------------------
# Пароль суперпользователя базы данных PostgreSQL
POSTGRES_PASSWORD=your_secure_postgres_password_123

# Имя очереди pgmq
PGMQ_QUEUE_NAME=rating_tasks
PGMQ_VT_SECONDS=60

# ------------------------------------------------------------------------------
# 4. БЕЗОПАСНОСТЬ И JWT КЛЮЧИ SUPABASE (AUTH, REST, STORAGE, STUDIO)
# ------------------------------------------------------------------------------
# Мастер-секрет для подписи JWT-токенов (минимум 32 символа)
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Публичный Anon ключ (подписан дефолтным JWT_SECRET, работает из коробки)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzkwMjI0OTQwLCJleHAiOjIxMDU1ODQ5NDB9.9hZnfSAT-xN-hfBctiRYT5cGp1IZFUP0t-SOR3D22oo

# Приватный Service Role ключ (подписан дефолтным JWT_SECRET, работает из коробки)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3OTAyMjQ5NDAsImV4cCI6MjEwNTU4NDk0MH0.iQw4olsCgk3eAEoESWzIlc4eZPibBjBjKBw_BGglNOI

# Приватный бакет хранилища фото (создается автоматически при первом запуске)
RATINGS_BUCKET=ratings_photos

# ------------------------------------------------------------------------------
# 5. НАСТРОЙКИ ФОНОВОГО ВОРКЕРА (RATE LIMITING & LONG-POLLING)
# ------------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=1500
WORKER_ERROR_COOLDOWN_MS=5000
MAX_TASK_RETRIES=3

# Задержка между запросами к Groq (3.5 сек защищает от бесплатного лимита RPM)
RATE_LIMIT_INTERVAL_MS=3500
RATE_LIMIT_BASE_BACKOFF_SEC=30
RATE_LIMIT_MAX_BACKOFF_SEC=120
RATE_LIMIT_MAX_JITTER_SEC=5
