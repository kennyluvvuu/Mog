# ==============================================================================
# Конфигурация Caddy Reverse Proxy (All-in-One Production)
# Домен настраивается через переменную DOMAIN в корневом .env файле
# ==============================================================================

{$DOMAIN:localhost}, :80 {
    # Сжатие ответов (Zstandard и Gzip)
    encode zstd gzip

    # Заголовки безопасности
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # 1. API маршруты приложения (Hono Edge API на Deno)
    # Включает поддержку Server-Sent Events (SSE) стриминга (/ratings/:id/stream)
    @api path /api/* /functions/v1/api/*
    handle @api {
        reverse_proxy api:8000 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 2. Supabase Auth (GoTrue)
    handle_path /auth/v1/* {
        reverse_proxy auth:9999 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 3. Supabase REST (PostgREST)
    handle_path /rest/v1/* {
        reverse_proxy rest:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 4. Supabase Storage API
    handle_path /storage/v1/* {
        reverse_proxy storage:5000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 5. Все остальные запросы направляются на Next.js Frontend
    handle {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
